<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="comprehensive_income_report" model="account.report">
            <field name="name">STATEMENT OF COMPREHENSIVE INCOME</field>
        </record>

        <!-- 1. INSURANCE REVENUE -->
        <record id="comp_inc_line_revenue" model="account.report.line">
            <field name="name">INSURANCE REVENUE</field>
            <field name="code">comp_inc_line_revenue</field>
            <field name="report_id" ref="comprehensive_income_report"/>
            <field name="sequence">10</field>
            <field name="hierarchy_level">1</field>
            <field name="groupby">account_id</field>
            <field name="expression_ids">
                <record id="comp_inc_exp_revenue" model="account.report.expression">
                    <field name="label">balance</field>
                    <field name="engine">domain</field>
                    <field name="formula">['|', ('account_id.comprehensive_income_category', '=', 'insurance_revenue'), '&amp;', ('account_id.comprehensive_income_category', '=', False), ('account_id.account_type', 'in', ('income', 'income_other'))]</field>
                    <field name="subformula">-sum</field>
                </record>
            </field>
        </record>

        <!-- 2. INSURANCE SERVICE EXPENSES -->
        <record id="comp_inc_line_expenses" model="account.report.line">
            <field name="name">INSURANCE SERVICE EXPENSES</field>
            <field name="code">comp_inc_line_expenses</field>
            <field name="report_id" ref="comprehensive_income_report"/>
            <field name="sequence">20</field>
            <field name="hierarchy_level">1</field>
            <field name="groupby">account_id</field>
            <field name="expression_ids">
                <record id="comp_inc_exp_expenses" model="account.report.expression">
                    <field name="label">balance</field>
                    <field name="engine">domain</field>
                    <field name="formula">[('account_id.comprehensive_income_category', '=', 'insurance_service_expenses')]</field>
                    <field name="subformula">sum</field>
                </record>
            </field>
        </record>

        <!-- 3. INSURANCE SERVICE RESULT -->
        <record id="comp_inc_line_service_result" model="account.report.line">
            <field name="name">INSURANCE SERVICE RESULT</field>
            <field name="code">comp_inc_line_service_result</field>
            <field name="report_id" ref="comprehensive_income_report"/>
            <field name="sequence">30</field>
            <field name="hierarchy_level">1</field>
            <field name="expression_ids">
                <record id="comp_inc_exp_service_result" model="account.report.expression">
                    <field name="label">balance</field>
                    <field name="engine">aggregation</field>
                    <field name="formula">comp_inc_line_revenue.balance - comp_inc_line_expenses.balance</field>
                </record>
            </field>
        </record>

        <!-- 4. INVESTMENT INCOME -->
        <record id="comp_inc_line_investment" model="account.report.line">
            <field name="name">INVESTMENT INCOME</field>
            <field name="code">comp_inc_line_investment</field>
            <field name="report_id" ref="comprehensive_income_report"/>
            <field name="sequence">40</field>
            <field name="hierarchy_level">1</field>
            <field name="groupby">account_id</field>
            <field name="expression_ids">
                <record id="comp_inc_exp_investment" model="account.report.expression">
                    <field name="label">balance</field>
                    <field name="engine">domain</field>
                    <field name="formula">[('account_id.comprehensive_income_category', '=', 'investment_income')]</field>
                    <field name="subformula">-sum</field>
                </record>
            </field>
        </record>

        <!-- 5. NET INSURANCE FINANCE EXPENSES -->
        <record id="comp_inc_line_finance_exp" model="account.report.line">
            <field name="name">Net insurance finance expenses (discount unwind, etc.)</field>
            <field name="code">comp_inc_line_finance_exp</field>
            <field name="report_id" ref="comprehensive_income_report"/>
            <field name="sequence">50</field>
            <field name="hierarchy_level">2</field>
            <field name="groupby">account_id</field>
            <field name="expression_ids">
                <record id="comp_inc_exp_finance_exp" model="account.report.expression">
                    <field name="label">balance</field>
                    <field name="engine">domain</field>
                    <field name="formula">[('account_id.comprehensive_income_category', '=', 'net_insurance_finance_expenses')]</field>
                    <field name="subformula">sum</field>
                </record>
            </field>
        </record>

        <!-- 6. FINANCE COST -->
        <record id="comp_inc_line_finance_cost" model="account.report.line">
            <field name="name">Finance cost (borrowings and lease liabilities)</field>
            <field name="code">comp_inc_line_finance_cost</field>
            <field name="report_id" ref="comprehensive_income_report"/>
            <field name="sequence">60</field>
            <field name="hierarchy_level">2</field>
            <field name="groupby">account_id</field>
            <field name="expression_ids">
                <record id="comp_inc_exp_finance_cost" model="account.report.expression">
                    <field name="label">balance</field>
                    <field name="engine">domain</field>
                    <field name="formula">[('account_id.comprehensive_income_category', '=', 'finance_cost')]</field>
                    <field name="subformula">sum</field>
                </record>
            </field>
        </record>

        <!-- 7. NET INVESTMENT AND FINANCIAL RESULT -->
        <record id="comp_inc_line_net_inv_result" model="account.report.line">
            <field name="name">NET INVESTMENT AND FINANCIAL RESULT</field>
            <field name="code">comp_inc_line_net_inv_result</field>
            <field name="report_id" ref="comprehensive_income_report"/>
            <field name="sequence">70</field>
            <field name="hierarchy_level">1</field>
            <field name="expression_ids">
                <record id="comp_inc_exp_net_inv_result" model="account.report.expression">
                    <field name="label">balance</field>
                    <field name="engine">aggregation</field>
                    <field name="formula">comp_inc_line_investment.balance - comp_inc_line_finance_exp.balance - comp_inc_line_finance_cost.balance</field>
                </record>
            </field>
        </record>

        <!-- 8. OPERATING EXPENSES -->
        <record id="comp_inc_line_operating" model="account.report.line">
            <field name="name">OPERATING EXPENSES</field>
            <field name="code">comp_inc_line_operating</field>
            <field name="report_id" ref="comprehensive_income_report"/>
            <field name="sequence">80</field>
            <field name="hierarchy_level">1</field>
            <field name="groupby">account_id</field>
            <field name="expression_ids">
                <record id="comp_inc_exp_operating" model="account.report.expression">
                    <field name="label">balance</field>
                    <field name="engine">domain</field>
                    <field name="formula">['|', ('account_id.comprehensive_income_category', '=', 'operating_expenses'), '&amp;', ('account_id.comprehensive_income_category', '=', False), ('account_id.account_type', 'in', ('expense', 'expense_depreciation', 'expense_direct_cost'))]</field>
                    <field name="subformula">sum</field>
                </record>
            </field>
        </record>

        <!-- 9. SURPLUS BEFORE TAX -->
        <record id="comp_inc_line_surplus_before_tax" model="account.report.line">
            <field name="name">SURPLUS BEFORE TAX</field>
            <field name="code">comp_inc_line_surplus_before_tax</field>
            <field name="report_id" ref="comprehensive_income_report"/>
            <field name="sequence">90</field>
            <field name="hierarchy_level">1</field>
            <field name="expression_ids">
                <record id="comp_inc_exp_surplus_before_tax" model="account.report.expression">
                    <field name="label">balance</field>
                    <field name="engine">aggregation</field>
                    <field name="formula">comp_inc_line_service_result.balance + comp_inc_line_net_inv_result.balance - comp_inc_line_operating.balance</field>
                </record>
            </field>
        </record>

        <!-- 10. INCOME TAX EXPENSE -->
        <record id="comp_inc_line_tax" model="account.report.line">
            <field name="name">Income tax expense</field>
            <field name="code">comp_inc_line_tax</field>
            <field name="report_id" ref="comprehensive_income_report"/>
            <field name="sequence">100</field>
            <field name="hierarchy_level">2</field>
            <field name="groupby">account_id</field>
            <field name="expression_ids">
                <record id="comp_inc_exp_tax" model="account.report.expression">
                    <field name="label">balance</field>
                    <field name="engine">domain</field>
                    <field name="formula">[('account_id.comprehensive_income_category', '=', 'income_tax')]</field>
                    <field name="subformula">sum</field>
                </record>
            </field>
        </record>

        <!-- 11. SURPLUS FOR THE PERIOD -->
        <record id="comp_inc_line_surplus_period" model="account.report.line">
            <field name="name">SURPLUS FOR THE PERIOD</field>
            <field name="code">comp_inc_line_surplus_period</field>
            <field name="report_id" ref="comprehensive_income_report"/>
            <field name="sequence">110</field>
            <field name="hierarchy_level">1</field>
            <field name="expression_ids">
                <record id="comp_inc_exp_surplus_period" model="account.report.expression">
                    <field name="label">balance</field>
                    <field name="engine">aggregation</field>
                    <field name="formula">comp_inc_line_surplus_before_tax.balance - comp_inc_line_tax.balance</field>
                </record>
            </field>
        </record>

        <!-- 12. OTHER COMPREHENSIVE INCOME -->
        <record id="comp_inc_line_other_comprehensive" model="account.report.line">
            <field name="name">OTHER COMPREHENSIVE INCOME</field>
            <field name="code">comp_inc_line_other_comprehensive</field>
            <field name="report_id" ref="comprehensive_income_report"/>
            <field name="sequence">120</field>
            <field name="hierarchy_level">1</field>
            <field name="groupby">account_id</field>
            <field name="expression_ids">
                <record id="comp_inc_exp_other_comprehensive" model="account.report.expression">
                    <field name="label">balance</field>
                    <field name="engine">domain</field>
                    <field name="formula">[('account_id.comprehensive_income_category', '=', 'other_comprehensive_income')]</field>
                    <field name="subformula">-sum</field>
                </record>
            </field>
        </record>

        <!-- 13. TOTAL COMPREHENSIVE SURPLUS/(DEFICIT) -->
        <record id="comp_inc_line_total_surplus" model="account.report.line">
            <field name="name">TOTAL COMPREHENSIVE SURPLUS/(DEFICIT) FOR THE PERIOD</field>
            <field name="code">comp_inc_line_total_surplus</field>
            <field name="report_id" ref="comprehensive_income_report"/>
            <field name="sequence">130</field>
            <field name="hierarchy_level">0</field>
            <field name="expression_ids">
                <record id="comp_inc_exp_total_surplus" model="account.report.expression">
                    <field name="label">balance</field>
                    <field name="engine">aggregation</field>
                    <field name="formula">comp_inc_line_surplus_period.balance + comp_inc_line_other_comprehensive.balance</field>
                </record>
            </field>
        </record>
    </data>
</odoo>
